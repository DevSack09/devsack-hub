// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ToolStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  tools Tool[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  tools Tool[]
}

model Technology {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  tools Tool[]
}

model Tool {
  id                  String     @id @default(cuid())
  name                String
  slug                String     @unique
  description         String
  url                 String
  imageUrl            String?
  recommendationLevel Int        @default(3)
  status              ToolStatus @default(ACTIVE)
  isFeatured          Boolean    @default(false)
  clicksCount         Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  tags         Tag[]
  technologies Technology[]

  @@index([status])
  @@index([isFeatured])
  @@index([categoryId])
}
